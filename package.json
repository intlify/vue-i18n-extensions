{
  "name": "@intlify/vue-i18n-extensions",
  "version": "9.1.0",
  "description": "vue-i18n extensions",
  "keywords": [
    "extensions",
    "i18n",
    "optimaization",
    "server-side-rendering",
    "vue",
    "vue-i18n"
  ],
  "homepage": "https://github.com/intlify/vue-i18n-extensions#readme",
  "bugs": {
    "url": "https://github.com/intlify/vue-i18n-extensions/issues"
  },
  "license": "MIT",
  "author": {
    "name": "kazuya kawaguchi",
    "email": "kawakazu80@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intlify/vue-i18n-extensions.git"
  },
  "files": [
    "dist/index.cjs",
    "dist/index.mjs",
    "dist/index.d.mts",
    "dist/index.d.cts"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "vp config --no-agent",
    "release": "bumpp",
    "build": "pnpm build:transpile",
    "build:docs": "api-docs-gen ./temp/vue-i18n-extensions.api.json -c ./docsgen.config.cjs -o ./docs",
    "build:extract": "api-extractor run -l -c ./api-extractor.json --typescript-compiler-folder node_modules/typescript",
    "build:transpile": "vp pack",
    "check-install": "vpx scripts/playwright.ts",
    "clean": "git clean -fdx",
    "coverage": "opener coverage/lcov-report/index.html",
    "example": "webpack serve --config example/webpack.config.js --inline --hot",
    "lint": "vp check",
    "fix": "vp check --fix",
    "test": "pnpm test:cover && pnpm check-install && pnpm test:e2e",
    "test:cover": "pnpm test:unit --coverage --coverage.include=src",
    "test:e2e": "vp test run -c ./vitest.e2e.config.ts",
    "test:unit": "vp test run",
    "test:watch": "vp test watch --no-cache",
    "watch": "tsc -p tsconfig.cjs.json --watch"
  },
  "dependencies": {
    "@babel/parser": "^8.0.0",
    "@vue/compiler-dom": "^3.2.45"
  },
  "devDependencies": {
    "@babel/types": "^8.0.0",
    "@kazupon/vp-config": "^1.1.0",
    "@microsoft/api-extractor": "^7.18.4",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "catalog:",
    "@vue/compiler-core": "^3.2.45",
    "@vue/compiler-sfc": "^3.2.45",
    "@vue/compiler-ssr": "^3.2.45",
    "@vue/runtime-dom": "^3.2.45",
    "@vue/server-renderer": "^3.2.45",
    "api-docs-gen": "^0.4.0",
    "bumpp": "^12.0.0",
    "get-port-please": "^3.1.2",
    "gh-changelogen": "^2.0.2",
    "jsdom": "^31.0.0",
    "opener": "^1.5.2",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vue": "^3.2.45"
  },
  "peerDependencies": {
    "@intlify/shared": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "@vue/compiler-dom": "^3.0.0",
    "vue": "^3.0.0",
    "vue-i18n": "^9.0.0 || ^10.0.0 || ^11.0.0"
  },
  "peerDependenciesMeta": {
    "@intlify/shared": {
      "optional": true
    },
    "@vue/compiler-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vue-i18n": {
      "optional": true
    }
  },
  "engines": {
    "node": ">= 22"
  },
  "packageManager": "pnpm@11.28.11"
}
